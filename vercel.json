{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix cosmic-kin-studio ci --include=dev",
  "buildCommand": "npm --prefix cosmic-kin-studio run build:wallet && node build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {"api/holder.js": {"maxDuration": 300,"includeFiles":"cosmic-kin-studio/public/deployment.json"}},
  "rewrites": [
    {"source":"/api/holder/:action","destination":"/api/holder?action=:action"},
    {"source":"/terms","destination":"/terms.html"},
    {"source":"/license","destination":"/license.html"}
  ],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
