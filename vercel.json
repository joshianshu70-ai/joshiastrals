{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/holder.js": {
      "maxDuration": 300,
      "includeFiles": "cosmic-kin-studio/public/deployment.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/holder/:action",
      "destination": "/api/holder?action=:action"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/license",
      "destination": "/license.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/risks",
      "destination": "/risks.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/how-to-mint",
      "destination": "/how-to-mint.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
